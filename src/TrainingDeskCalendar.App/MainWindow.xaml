<Window x:Class="TrainingDeskCalendar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:calendar="clr-namespace:TrainingDeskCalendar.App.Calendar"
        Title="训练桌历"
        Width="1120"
        Height="470"
        MinWidth="840"
        MinHeight="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Topmost="False"
        ShowInTaskbar="False"
        PreviewMouseLeftButtonDown="OnWindowPreviewMouseLeftButtonDown">
  <Window.Resources>
    <calendar:TaskColorBrushConverter x:Key="TaskColorBrushConverter" />
    <calendar:TaskColorSelectionConverter x:Key="TaskColorSelectionConverter" />
    <Style x:Key="ColorChoiceStyle" TargetType="RadioButton">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Swatch" Background="{TemplateBinding Background}" BorderBrush="#66000000" BorderThickness="1" CornerRadius="3" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Swatch" Property="BorderBrush" Value="#20262B" />
                <Setter TargetName="Swatch" Property="BorderThickness" Value="3" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Swatch" Property="BorderBrush" Value="#146C94" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ReadCardStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Visible" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsEditing}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Border x:Name="SurfaceBorder" Margin="10" Padding="14" CornerRadius="8" Background="#D9F7F8FA" BorderBrush="#BFFFFFFF" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8"
                 MouseLeftButtonDown="OnHeaderMouseLeftButtonDown"
                 MouseMove="OnHeaderMouseMove"
                 MouseLeftButtonUp="OnHeaderMouseLeftButtonUp"
                 LostMouseCapture="OnHeaderLostMouseCapture">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="训练桌历" />
          <TextBlock Margin="10,3,0,0" Foreground="#5D6972" Text="两周训练计划" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Margin="4,0,0,0" Padding="9,3" ToolTip="上一页" Click="OnPreviousClick" Content="‹" />
          <Button Margin="4,0,0,0" Padding="9,3" ToolTip="下一页" Click="OnNextClick" Content="›" />
          <Button Margin="10,0,0,0" Padding="9,3" ToolTip="锁定或解锁组件" Click="OnLockClick" Content="锁定" />
          <Button Margin="10,0,0,0" Padding="9,3" ToolTip="打开设置" Click="OnSettingsClick" Content="设置" />
          <Button Margin="4,0,0,0" Padding="9,3" ToolTip="最小化" Click="OnMinimizeClick" Content="—" />
          <Button Margin="4,0,0,0" Padding="9,3" ToolTip="关闭程序" Click="OnCloseClick" Content="×" />
        </StackPanel>
      </DockPanel>
      <TextBlock Grid.Row="1" Margin="0,0,0,8" Foreground="#20262B" Text="{Binding RangeLabel}" />
      <ItemsControl Grid.Row="2" ItemsSource="{Binding Days}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="7" Rows="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="3" Padding="8" CornerRadius="5" BorderBrush="#28000000" BorderThickness="1" Background="{Binding SelectedColor, Converter={StaticResource TaskColorBrushConverter}}" MouseLeftButtonUp="OnCardMouseLeftButtonUp">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                      <Setter Property="Opacity" Value="0.58" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                  <TextBlock FontSize="11" Foreground="#5F6B74" Text="{Binding Weekday}" />
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Margin="0,0,5,0" FontSize="16" FontWeight="Bold" Text="{Binding DayNumber}" />
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsCompleted, Mode=OneWay}" ToolTip="切换完成状态" Click="OnCompletedClick" />
                  </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1">
                  <Grid Style="{StaticResource ReadCardStyle}">
                    <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding DisplayText}" />
                  </Grid>
                  <Border Padding="4" Background="#F2FFFFFF">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <TextBox MinHeight="42" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ColorChoiceStyle}" Background="#BFE3DA" Tag="1" ToolTip="青绿色" IsChecked="{Binding SelectedColor, Mode=OneWay, Converter={StaticResource TaskColorSelectionConverter}, ConverterParameter=1}" Click="OnColorClick" />
                        <RadioButton Style="{StaticResource ColorChoiceStyle}" Background="#C7D8F2" Tag="2" ToolTip="蓝色" IsChecked="{Binding SelectedColor, Mode=OneWay, Converter={StaticResource TaskColorSelectionConverter}, ConverterParameter=2}" Click="OnColorClick" />
                        <RadioButton Style="{StaticResource ColorChoiceStyle}" Background="#F4D1A6" Tag="3" ToolTip="橙色" IsChecked="{Binding SelectedColor, Mode=OneWay, Converter={StaticResource TaskColorSelectionConverter}, ConverterParameter=3}" Click="OnColorClick" />
                        <RadioButton Style="{StaticResource ColorChoiceStyle}" Background="#F1C2C2" Tag="4" ToolTip="红色" IsChecked="{Binding SelectedColor, Mode=OneWay, Converter={StaticResource TaskColorSelectionConverter}, ConverterParameter=4}" Click="OnColorClick" />
                        <RadioButton Style="{StaticResource ColorChoiceStyle}" Background="#D9C7E8" Tag="5" ToolTip="紫色" IsChecked="{Binding SelectedColor, Mode=OneWay, Converter={StaticResource TaskColorSelectionConverter}, ConverterParameter=5}" Click="OnColorClick" />
                        <RadioButton Style="{StaticResource ColorChoiceStyle}" Background="#D5DADF" Tag="6" ToolTip="灰色" IsChecked="{Binding SelectedColor, Mode=OneWay, Converter={StaticResource TaskColorSelectionConverter}, ConverterParameter=6}" Click="OnColorClick" />
                        <Button Margin="8,0,0,0" Padding="6,2" Content="保存" Click="OnSaveCardClick" />
                      </StackPanel>
                      <TextBlock Margin="0,4,0,0" Foreground="#B42318" FontSize="10" TextWrapping="Wrap" Text="{Binding SaveError}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock x:Name="ErrorStatusText" Grid.Row="3" Margin="0,8,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="#5D6972" />
    </Grid>
  </Border>
</Window>
