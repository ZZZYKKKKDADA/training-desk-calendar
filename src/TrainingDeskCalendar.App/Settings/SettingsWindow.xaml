<Window x:Class="TrainingDeskCalendar.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="训练桌历设置"
        Width="430"
        Height="430"
        MinWidth="400"
        MinHeight="360"
        ResizeMode="CanResizeWithGrip">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="设置" />
      <TextBlock Margin="0,18,0,5" Text="背景方案" />
      <ComboBox x:Name="ThemeCombo" SelectionChanged="OnThemeChanged">
        <ComboBoxItem Content="浅色" />
        <ComboBoxItem Content="深色" />
      </ComboBox>
      <TextBlock Margin="0,16,0,5" Text="背景透明度" />
      <Slider Minimum="0.4" Maximum="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock HorizontalAlignment="Right" Text="{Binding Opacity, StringFormat={}{0:P0}}" />
      <CheckBox Margin="0,16,0,0" Content="锁定组件位置和尺寸" IsChecked="{Binding IsLocked, Mode=TwoWay}" />
      <CheckBox Margin="0,8,0,0" Content="开机自动启动" IsChecked="{Binding StartWithWindows, Mode=OneWay}" Click="OnStartupClick" />
      <Separator Margin="0,20,0,14" />
      <WrapPanel>
        <Button Margin="0,0,8,8" Padding="10,5" Content="重置窗口" Click="OnResetWindowClick" />
        <Button Margin="0,0,8,8" Padding="10,5" Content="导出数据" Click="OnExportClick" />
        <Button Margin="0,0,8,8" Padding="10,5" Content="导入数据" Click="OnImportClick" />
        <Button Margin="0,0,8,8" Padding="10,5" Content="检查更新" Click="OnUpdateClick" />
      </WrapPanel>
      <TextBlock Margin="0,8,0,0" Foreground="#B42318" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
      <TextBlock Margin="0,8,0,0" Foreground="#146C94" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
      <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Margin="0,0,8,0" Padding="14,5" Content="取消" Click="OnCancelClick" />
        <Button Padding="14,5" Content="应用" Click="OnApplyClick" />
      </StackPanel>
      <TextBlock Margin="0,20,0,0" Foreground="#5D6972" Text="{Binding VersionText}" />
      <TextBlock Margin="0,4,0,0" Foreground="#5D6972" Text="MIT License · GitHub 项目链接将在阶段 3 发布时启用" />
    </StackPanel>
  </ScrollViewer>
</Window>
